[Unit]
Description=Griddick TUN to AX.25 UI daemon
Documentation=file:///opt/griddick/griddickd.conf.example
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=griddick
Group=griddick
SupplementaryGroups=dialout
WorkingDirectory=/opt/griddick
ExecStart=/opt/griddick/bin/griddickd -c /opt/griddick/griddickd.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
